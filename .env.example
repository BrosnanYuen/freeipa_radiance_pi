# Copy to .env (up.sh does this automatically) and adjust for this host.
# Every image is pinned to a tag *and* a digest. Do not lower these pins silently.
# Digests captured 2026-10-31.

# FreeIPA 4.13.4 server image (systemd; see deploy/ipa/README.md).
FREEIPA_IMAGE=quay.io/freeipa/freeipa-server:rocky-9-4.13.4@sha256:c20016610558bbb22805b319e96c32dfe6ac100eb2f63a60fd745149ade1da87

# radiance 1.15.1 inference server (AMD GPU; the gpu profile only).
RADIANCE_IMAGE=stilldeadcode/radiance:1.15.1@sha256:cccbc0bd6bfef1441e8fcf3ca8d10313d4e6d18a03d9c6ede3bcb15d95376668

# Base images for the local builds.
EDGE_BASE_IMAGE=debian:bookworm-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3
PI_BASE_IMAGE=node:22-bookworm@sha256:18a6d90fd60542269850c80ca03b29b1d9b14d6b221ac7ee8e35b0d33ef904bd
TESTS_BASE_IMAGE=python:3.13-slim@sha256:2d44738ebf4ce5f63b9d9ea871e9c7cfdc0426f7b0c97cac915fd88ded1d86bb

# Pi coding agent, pinned for reproducibility. The image verifies the npm integrity.
PI_VERSION=1.4.0
PI_INTEGRITY=sha512-Z41LpZ3yYHSC/UUps6Mr39UMFPwH8elhJBG9DY1P7kuzsE5qSK/6eMj2EHzO5evJRQWLbKSqUMw+4nCNtIyiQg==

# Model container directory mounted read-only at /models.
RADIANCE_MODELS=/srv/models/rad
RADIANCE_MODEL_FILE=qwen3.8-27b-mxfp4.rad
RADIANCE_SERVED_NAME=qwen3.8-27b
RADIANCE_CONTEXT_WINDOW=200000

# Required. Docker's default seccomp profile blocks radiance startup.
# Relative paths are resolved by scripts/up.sh; an absolute path also works.
RADIANCE_SECCOMP=./deploy/radiance/seccomp-radiance.json

# Bind address for the published host ports. Loopback by default; set 0.0.0.0 only behind a firewall.
BIND_ADDR=127.0.0.1

# UIDs/GIDs. up.sh chowns run/ccache, run/pi-agent and work/ to PI_UID:PI_GID.
PI_UID=1000
PI_GID=1000
RADIANCE_UID=1000
RADIANCE_GID=1000

# Host GPU device groups: getent group render | cut -d: -f3 ; getent group video | cut -d: -f3
RENDER_GID=989
VIDEO_GID=985
